# Atlas environment template.
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# `.env*` files are gitignored. Never commit real values.
# Every variable here is declared in src/lib/config/env.schema.ts — that schema
# is the contract. Reading process.env anywhere else is a defect.
#
# M0 STATUS: Atlas has no required configuration yet. The app runs with this
# file entirely empty. Variables become required as milestones land; the build
# will tell you exactly which key is missing.

# ---------------------------------------------------------------------------
# Atlas-owned configuration
# ---------------------------------------------------------------------------

# Canonical absolute origin for this deployment, no trailing slash.
# Optional: derived from Vercel's own variables when unset.
# Set this once a custom domain exists — M3 binds passkey credentials to a
# fixed origin, and changing it later invalidates registered passkeys.
# ATLAS_APP_URL="http://localhost:3000"

# debug | info | warn | error   (default: info)
# ATLAS_LOG_LEVEL="debug"

# ---------------------------------------------------------------------------
# Provided automatically by Vercel — never set these by hand
# ---------------------------------------------------------------------------
#   VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL,
#   VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF

# ---------------------------------------------------------------------------
# Not yet used. Listed so the shape of what is coming is visible.
# ---------------------------------------------------------------------------
# M2  DATABASE_URL=            # Neon pooled connection string
# M3  BETTER_AUTH_SECRET=      # 32+ random bytes
# M4  OPENAI_API_KEY=
# M5  ANTHROPIC_API_KEY=       # secondary provider, proves the abstraction
